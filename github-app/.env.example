# GitHub App credentials
GITHUB_APP_ID=123456
# Inline PEM (escape newlines as \n) or absolute path to .pem file
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMII...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview   # or gemini-2.5-flash (higher free-tier quota)
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_TOTAL_BUDGET_SECONDS=90
GEMINI_REASONING_THINKING_LEVEL=medium
GEMINI_VERIFICATION_THINKING_LEVEL=low
GEMINI_REASONING_MAX_OUTPUT_TOKENS=4096
GEMINI_VERIFICATION_MAX_OUTPUT_TOKENS=3072

# Shared secret for frontend→backend API auth (required outside webhook/health routes)
API_SECRET=some_random_secret_here

# Database (defaults to local SQLite)
DATABASE_URL=sqlite:///./scans.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/iac_scanner
